{
  "manifest_version": 3,
  "name": "Split Keyboard for monkeytype",
  "version": "0.3.0",
  "description": "Shows your Vial or VIA keyboard live in monkeytype: your keymap, layers, the next key and the finger to use.",
  "homepage_url": "https://github.com/GordonMohrin/split-keyboard-for-monkeytype",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://monkeytype.com/*"
      ],
      "js": [
        "halcyon-monkeytype.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
